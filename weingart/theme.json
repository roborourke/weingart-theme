{
	"$schema": "https://schemas.wp.org/wp/7.1/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "44rem",
			"wideSize": "80rem"
		},
		"color": {
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"palette": [
				{ "slug": "base", "name": "Paper", "color": "#f3f0e8" },
				{ "slug": "contrast", "name": "Ink", "color": "#111111" },
				{ "slug": "accent-1", "name": "Cyan film", "color": "#00a3e0" },
				{ "slug": "accent-2", "name": "Magenta film", "color": "#ee1a8c" },
				{ "slug": "accent-3", "name": "Yellow film", "color": "#ffe500" },
				{ "slug": "accent-4", "name": "Basel red", "color": "#dc0613" },
				{ "slug": "muted", "name": "Grey (large type, rules, dark grounds)", "color": "#8a8a8a" },
				{ "slug": "muted-strong", "name": "Grey (small type on paper)", "color": "#6b6b6b" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"letterSpacing": true,
			"textTransform": true,
			"writingMode": true,
			"fontFamilies": [
				{
					"slug": "grotesk",
					"name": "Archivo",
					"fontFamily": "Archivo, \"Helvetica Neue\", Arial, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Archivo",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontStretch": "62% 125%",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/archivo-latin-wdth-normal.woff2" ]
						}
					]
				},
				{
					"slug": "mono",
					"name": "IBM Plex Mono",
					"fontFamily": "\"IBM Plex Mono\", ui-monospace, \"Courier New\", monospace",
					"fontFace": [
						{
							"fontFamily": "IBM Plex Mono",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/ibm-plex-mono-latin-400-normal.woff2" ]
						},
						{
							"fontFamily": "IBM Plex Mono",
							"fontStyle": "normal",
							"fontWeight": "700",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/ibm-plex-mono-latin-700-normal.woff2" ]
						}
					]
				}
			],
			"fontSizes": [
				{ "slug": "x-small", "name": "Caption", "size": "0.75rem" },
				{ "slug": "small", "name": "Small", "size": "0.875rem" },
				{ "slug": "base", "name": "Body", "size": "1rem" },
				{ "slug": "large", "name": "Large", "size": "1.25rem", "fluid": { "min": "1.125rem", "max": "1.375rem" } },
				{ "slug": "x-large", "name": "Extra large", "size": "2rem", "fluid": { "min": "1.5rem", "max": "2.25rem" } },
				{ "slug": "xx-large", "name": "Headline", "size": "3.5rem", "fluid": { "min": "2.25rem", "max": "4rem" } },
				{ "slug": "display", "name": "Display", "size": "7rem", "fluid": { "min": "3.25rem", "max": "8rem" } },
				{ "slug": "giant", "name": "Numeral", "size": "16rem", "fluid": { "min": "6rem", "max": "18rem" } }
			]
		},
		"spacing": {
			"blockGap": true,
			"margin": true,
			"padding": true,
			"units": [ "rem", "em", "%", "vw", "vh" ],
			"spacingSizes": [
				{ "slug": "10", "name": "1", "size": "0.5rem" },
				{ "slug": "20", "name": "2", "size": "1rem" },
				{ "slug": "30", "name": "3", "size": "1.5rem" },
				{ "slug": "40", "name": "4", "size": "2.5rem", "fluid": { "min": "1.5rem", "max": "2.5rem" } },
				{ "slug": "50", "name": "5 (step)", "size": "4rem", "fluid": { "min": "1rem", "max": "4rem" } },
				{ "slug": "60", "name": "6 (step x2)", "size": "8rem", "fluid": { "min": "2rem", "max": "8rem" } },
				{ "slug": "70", "name": "7 (step x3)", "size": "12rem", "fluid": { "min": "3rem", "max": "12rem" } },
				{ "slug": "80", "name": "8", "size": "16rem", "fluid": { "min": "4rem", "max": "16rem" } },
				{ "slug": "90", "name": "9", "size": "24rem", "fluid": { "min": "6rem", "max": "24rem" } }
			]
		},
		"custom": { "film-blend": "multiply" },
		"border": { "radius": true },
		"dimensions": { "minHeight": true }
	},
	"styles": {
		"color": {
			"background": "var:preset|color|base",
			"text": "var:preset|color|contrast"
		},
		"typography": {
			"fontFamily": "var:preset|font-family|grotesk",
			"fontSize": "var:preset|font-size|base",
			"lineHeight": "1.5"
		},
		"spacing": {
			"blockGap": "var:preset|spacing|30",
			"padding": {
				"left": "var:preset|spacing|40",
				"right": "var:preset|spacing|40"
			}
		},
		"elements": {
			"link": {
				"color": { "text": "inherit" },
				"typography": { "textDecoration": "underline" },
				":hover": {
					"color": { "background": "var:preset|color|accent-3", "text": "var:preset|color|contrast" },
					"typography": { "textDecoration": "none" }
				},
				":focus-visible": {
					"outline": { "color": "currentColor", "offset": "3px", "style": "solid", "width": "3px" }
				}
			},
			"button": {
				"color": { "background": "var:preset|color|contrast", "text": "var:preset|color|base" },
				"border": { "radius": "0" },
				"typography": {
					"fontFamily": "var:preset|font-family|mono",
					"fontSize": "var:preset|font-size|small",
					"fontWeight": "700",
					"letterSpacing": "0.08em",
					"textTransform": "uppercase",
					"textDecoration": "none"
				},
				"spacing": { "padding": { "top": "var:preset|spacing|20", "bottom": "var:preset|spacing|20", "left": "var:preset|spacing|30", "right": "var:preset|spacing|30" } },
				":hover": {
					"color": { "background": "var:preset|color|accent-3", "text": "var:preset|color|contrast" }
				},
				":focus-visible": {
					"outline": { "color": "currentColor", "offset": "3px", "style": "solid", "width": "3px" }
				}
			},
			"heading": {
				"typography": {
					"fontWeight": "800",
					"lineHeight": "1",
					"letterSpacing": "-0.02em"
				}
			},
			"h1": { "typography": { "fontSize": "var:preset|font-size|xx-large", "fontWeight": "900" } },
			"h2": { "typography": { "fontSize": "var:preset|font-size|x-large" } },
			"h3": { "typography": { "fontSize": "var:preset|font-size|large" } },
			"h4": { "typography": { "fontSize": "var:preset|font-size|base" } },
			"h5": {
				"typography": {
					"fontFamily": "var:preset|font-family|mono",
					"fontSize": "var:preset|font-size|small",
					"fontWeight": "700",
					"letterSpacing": "0.1em",
					"textTransform": "uppercase"
				}
			},
			"h6": {
				"typography": {
					"fontFamily": "var:preset|font-family|mono",
					"fontSize": "var:preset|font-size|x-small",
					"fontWeight": "700",
					"letterSpacing": "0.1em",
					"textTransform": "uppercase"
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontSize": "var:preset|font-size|large",
					"fontWeight": "900",
					"letterSpacing": "-0.01em",
					"textTransform": "uppercase"
				},
				"elements": { "link": { "typography": { "textDecoration": "none" } } }
			},
			"core/site-tagline": {
				"typography": {
					"fontFamily": "var:preset|font-family|mono",
					"fontSize": "var:preset|font-size|x-small",
					"letterSpacing": "0.08em",
					"textTransform": "uppercase"
				}
			},
			"core/navigation": {
				"typography": {
					"fontFamily": "var:preset|font-family|mono",
					"fontSize": "var:preset|font-size|small",
					"letterSpacing": "0.08em",
					"textTransform": "uppercase"
				},
				"elements": { "link": { "typography": { "textDecoration": "none" } } }
			},
			"core/post-title": {
				"typography": { "fontWeight": "900", "lineHeight": "0.95", "letterSpacing": "-0.03em" },
				"elements": { "link": { "typography": { "textDecoration": "none" } } }
			},
			"core/post-date": {
				"typography": {
					"fontFamily": "var:preset|font-family|mono",
					"fontSize": "var:preset|font-size|x-small",
					"letterSpacing": "0.06em",
					"textTransform": "uppercase"
				}
			},
			"core/post-terms": {
				"typography": {
					"fontFamily": "var:preset|font-family|mono",
					"fontSize": "var:preset|font-size|x-small",
					"letterSpacing": "0.1em",
					"textTransform": "uppercase"
				}
			},
			"core/post-excerpt": {
				"typography": { "fontSize": "var:preset|font-size|small" }
			},
			"core/query-pagination": {
				"typography": {
					"fontFamily": "var:preset|font-family|mono",
					"fontSize": "var:preset|font-size|small",
					"letterSpacing": "0.08em",
					"textTransform": "uppercase"
				}
			},
			"core/quote": {
				"border": { "left": { "color": "currentColor", "style": "solid", "width": "0.5rem" } },
				"spacing": { "padding": { "left": "var:preset|spacing|30" } },
				"typography": { "fontSize": "var:preset|font-size|x-large", "fontWeight": "700", "lineHeight": "1.15" },
				"elements": {
					"cite": {
						"typography": {
							"fontFamily": "var:preset|font-family|mono",
							"fontSize": "var:preset|font-size|x-small",
							"fontStyle": "normal",
							"letterSpacing": "0.08em",
							"textTransform": "uppercase"
						}
					}
				}
			},
			"core/separator": {
				"color": { "text": "var:preset|color|contrast" }
			},
			"core/image": {
				"border": { "radius": "0" }
			},
			"core/code": {
				"typography": { "fontFamily": "var:preset|font-family|mono", "fontSize": "var:preset|font-size|small" }
			},
			"core/preformatted": {
				"typography": { "fontFamily": "var:preset|font-family|mono", "fontSize": "var:preset|font-size|small" }
			},
			"core/search": {
				"typography": { "fontFamily": "var:preset|font-family|mono", "fontSize": "var:preset|font-size|small" }
			}
		},
		"css": "html{scroll-padding-top:var(--wp--preset--spacing--40)}@media (prefers-reduced-motion:no-preference){a,.wp-element-button{transition:background-color .15s linear,color .15s linear}}"
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	]
}
