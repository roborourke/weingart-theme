{
	"$schema": "https://schemas.wp.org/wp/7.1/theme.json",
	"version": 3,
	"title": "Halftone",
	"slug": "halftone",
	"blockTypes": [ "core/group" ],
	"styles": {
		"color": { "text": "var:preset|color|contrast" },
		"spacing": { "padding": { "top": "var:preset|spacing|60", "bottom": "var:preset|spacing|60" } },
		"elements": {
			"button": {
				"color": { "background": "var:preset|color|contrast", "text": "var:preset|color|base" },
				":focus-visible": {
					"outline": { "color": "var:preset|color|contrast", "offset": "3px", "style": "solid", "width": "3px" }
				}
			}
		},
		"css": "& .is-style-caption{color:var(--wp--preset--color--muted-strong)}"
	}
}
